# Site production URL (no trailing slash)
VITE_SITE_URL=https://naiimbsili.com

# Microsoft Clarity Project ID
VITE_CLARITY_PROJECT_ID=

# Supabase Configuration (Public anon key only - NEVER use service_role key in frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ==============================================================================
# SERVER-SIDE MCP GATEWAY CONFIGURATION (Keep strictly private / Never prefix with VITE_)
# ==============================================================================
# Dedicated API Server Port (Optional, default 3001)
API_PORT=3001

# 1. n8n MCP Server Connection (server-side only)
# Endpoint URL (e.g. https://your-subdomain.app.n8n.cloud/mcp-server/http)
N8N_MCP_SERVER_URL=
# n8n MCP Bearer Access Token
N8N_MCP_ACCESS_TOKEN=

# 2. Gmail MCP Server Connection (server-side only)
# Upstream Gmail MCP endpoint URL (e.g. http://localhost:3100/mcp or VPS internal network)
GMAIL_MAIN_SERVER_URL=http://localhost:3100/mcp
# Shared bearer token for authenticating to the Gmail MCP server
GMAIL_MAIN_ACCESS_TOKEN=
