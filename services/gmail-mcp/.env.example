# Gmail MCP Server Environment Configuration

PORT=3100
HOST=127.0.0.1
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. MCP Service Authentication (naiimOS -> gmail-mcp)
# ------------------------------------------------------------------------------
# Shared bearer token protecting the MCP HTTP endpoint (POST /mcp).
# The naiimOS MCP Gateway sends this in the 'Authorization: Bearer <token>' header.
# This prevents unauthorized access to the Gmail MCP server.
GMAIL_MCP_ACCESS_TOKEN=your-random-secure-mcp-bearer-token-here

# ------------------------------------------------------------------------------
# 2. Google OAuth Credentials (gmail-mcp -> Google Gmail API)
# ------------------------------------------------------------------------------
# Server-side Google OAuth 2.0 credentials used to authenticate directly against
# the Google Gmail API. The Gmail MCP server manages the OAuth token lifecycle
# and automatically refreshes access tokens using GMAIL_REFRESH_TOKEN.
# naiimOS NEVER receives or handles these Google OAuth credentials.
#
# Scopes required:
#   - https://www.googleapis.com/auth/gmail.readonly
#   - https://www.googleapis.com/auth/gmail.compose
# NOTE: DO NOT use https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Redirect URI configured in Google Cloud Console OAuth Client
# Default for local development: http://localhost:3100/oauth/google/callback
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3100/oauth/google/callback
